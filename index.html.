
<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Program Menentukan Rute Perjalanan</title>

<link rel="stylesheet"
href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"/>

<style>
* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  font-family: Arial, sans-serif;
  background: #f1f5f9;
  color: #172b4d;
}

header {
  background: #102a43;
  color: white;
  padding: 25px 18px;
}

header h1 {
  font-size: 23px;
  margin-bottom: 8px;
}

header p {
  font-size: 13px;
  color: #cbd5e1;
}

.container {
  max-width: 750px;
  margin: auto;
  padding: 16px;
}

.panel {
  background: white;
  padding: 20px;
  border-radius: 15px;
  margin-bottom: 16px;
  box-shadow: 0 3px 12px #00000010;
}

h2 {
  font-size: 18px;
  margin-bottom: 15px;
}

label {
  display: block;
  font-size: 13px;
  font-weight: bold;
  margin: 13px 0 7px;
}

select {
  width: 100%;
  padding: 13px;
  border: 1px solid #cbd5e1;
  border-radius: 9px;
  font-size: 14px;
  background: white;
}

button {
  width: 100%;
  padding: 14px;
  background: #1677d2;
  color: white;
  border: none;
  border-radius: 9px;
  font-size: 15px;
  font-weight: bold;
  margin-top: 18px;
  cursor: pointer;
}

button:active {
  background: #105ca5;
}

#map {
  height: 350px;
  width: 100%;
  border-radius: 12px;
  z-index: 1;
}

.result {
  display: none;
  background: #eff6ff;
  padding: 15px;
  border-radius: 10px;
  margin-top: 15px;
  line-height: 1.8;
}

.result strong {
  color: #1265ad;
}

footer {
  text-align: center;
  padding: 20px;
  font-size: 12px;
  color: #64748b;
}
</style>
</head>

<body>

<header>
  <h1>ROUTE FINDER</h1>
  <p>Program Menentukan Rute Perjalanan</p>
</header>

<div class="container">

  <div class="panel">
    <h2>Rencanakan Perjalanan</h2>

    <label>Lokasi Keberangkatan</label>
    <select id="awal"></select>

    <label>Lokasi Tujuan</label>
    <select id="tujuan"></select>

    <button onclick="cariRute()">
      TENTUKAN RUTE TERPENDEK
    </button>

    <div class="result" id="hasil"></div>
  </div>

  <div class="panel">
    <h2>Peta Perjalanan</h2>
    <div id="map"></div>
  </div>

  <div class="panel">
    <h2>Informasi Algoritma</h2>
    <p style="font-size:14px;line-height:1.8">
      Website ini menggunakan Algoritma Dijkstra
      untuk mencari jalur dengan total jarak
      terpendek berdasarkan jaringan lokasi
      yang telah ditentukan.
    </p>
  </div>

</div>

<footer>
  Project Informatika | Program Rute Perjalanan
  <br>Algoritma Dijkstra
</footer>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<script>

// DATA LOKASI DI MAKASSAR
const lokasi = {
  "Pantai Losari": [-5.1442, 119.4050],
  "Fort Rotterdam": [-5.1330, 119.4059],
  "Karebosi": [-5.1365, 119.4120],
  "Masjid 99 Kubah": [-5.1300, 119.4025],
  "Trans Studio": [-5.1570, 119.3970],
  "Mall Panakkukang": [-5.1590, 119.4470],
  "Universitas Hasanuddin": [-5.1310, 119.4870]
};

// JARINGAN JALAN CONTOH DAN JARAK (KM)
const graf = {
  "Pantai Losari": {
    "Fort Rotterdam": 1.5,
    "Trans Studio": 2.5,
    "Masjid 99 Kubah": 2.0
  },

  "Fort Rotterdam": {
    "Pantai Losari": 1.5,
    "Karebosi": 1.8,
    "Masjid 99 Kubah": 1.0
  },

  "Karebosi": {
    "Fort Rotterdam": 1.8,
    "Mall Panakkukang": 6.0,
    "Universitas Hasanuddin": 7.0
  },

  "Masjid 99 Kubah": {
    "Pantai Losari": 2.0,
    "Fort Rotterdam": 1.0,
    "Trans Studio": 3.0
  },

  "Trans Studio": {
    "Pantai Losari": 2.5,
    "Masjid 99 Kubah": 3.0,
    "Mall Panakkukang": 7.0
  },

  "Mall Panakkukang": {
    "Trans Studio": 7.0,
    "Karebosi": 6.0,
    "Universitas Hasanuddin": 5.0
  },

  "Universitas Hasanuddin": {
    "Karebosi": 7.0,
    "Mall Panakkukang": 5.0
  }
};

// MEMBUAT PETA
const map = L.map('map').setView(
  [-5.143, 119.420], 13
);

L.tileLayer(
  'https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',
  {
    attribution: '&copy; OpenStreetMap'
  }
).addTo(map);

// MENAMPILKAN MARKER LOKASI
Object.entries(lokasi).forEach(([nama, koordinat]) => {
  L.marker(koordinat)
    .addTo(map)
    .bindPopup(nama);
});

// MENGISI PILIHAN LOKASI
const awal = document.getElementById("awal");
const tujuan = document.getElementById("tujuan");

Object.keys(lokasi).forEach(nama => {
  awal.add(new Option(nama, nama));
  tujuan.add(new Option(nama, nama));
});

awal.value = "Pantai Losari";
tujuan.value = "Fort Rotterdam";

// GARIS RUTE
let garisRute = null;

// ALGORITMA DIJKSTRA
function dijkstra(mulai, akhir) {

  let jarak = {};
  let sebelumnya = {};
  let dikunjungi = new Set();

  Object.keys(graf).forEach(nama => {
    jarak[nama] = Infinity;
    sebelumnya[nama] = null;
  });

  jarak[mulai] = 0;

  while (true) {

    let sekarang = null;
    let jarakTerkecil = Infinity;

    for (let nama in jarak) {
      if (
        !dikunjungi.has(nama) &&
        jarak[nama] < jarakTerkecil
      ) {
        jarakTerkecil = jarak[nama];
        sekarang = nama;
      }
    }

    if (sekarang === null) break;
    if (sekarang === akhir) break;

    dikunjungi.add(sekarang);

    for (let tetangga in graf[sekarang]) {

      let jarakBaru =
        jarak[sekarang] + graf[sekarang][tetangga];

      if (jarakBaru < jarak[tetangga]) {
        jarak[tetangga] = jarakBaru;
        sebelumnya[tetangga] = sekarang;
      }
    }
  }

  if (jarak[akhir] === Infinity) {
    return null;
  }

  let rute = [];
  let sekarang = akhir;

  while (sekarang !== null) {
    rute.unshift(sekarang);
    sekarang = sebelumnya[sekarang];
  }

  return {
    rute: rute,
    jarak: jarak[akhir]
  };
}

// FUNGSI MENENTUKAN RUTE
function cariRute() {

  const dari = awal.value;
  const ke = tujuan.value;
  const hasil = document.getElementById("hasil");

  if (dari === ke) {
    alert("Lokasi awal dan tujuan tidak boleh sama!");
    return;
  }

  const hasilRute = dijkstra(dari, ke);

  if (!hasilRute) {
    hasil.innerHTML = "Rute tidak ditemukan.";
    hasil.style.display = "block";
    return;
  }

  const koordinatRute = hasilRute.rute.map(
    nama => lokasi[nama]
  );

  if (garisRute) {
    map.removeLayer(garisRute);
  }

  garisRute = L.polyline(
    koordinatRute,
    {
      color: "#1677d2",
      weight: 6
    }
  ).addTo(map);

  map.fitBounds(garisRute.getBounds(), {
    padding: [30, 30]
  });

  hasil.innerHTML = `
    <strong>Rute Berhasil Ditemukan!</strong><br>
    Lokasi Awal: ${dari}<br>
    Lokasi Tujuan: ${ke}<br>
    Jalur Perjalanan: ${hasilRute.rute.join(" → ")}<br>
    Total Jarak: ${hasilRute.jarak.toFixed(1)} KM
  `;

  hasil.style.display = "block";
}

// MENAMPILKAN RUTE AWAL
cariRute();

</script>

</body>
</html>
